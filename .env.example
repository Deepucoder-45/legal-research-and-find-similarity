# Backend-only secrets. Never prefix secrets with NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
SEARCH_PROVIDER=ddgs
SEARCH_API_KEY=
DATABASE_URL=
VECTOR_DB_PATH=./data/chroma
AUTH_SECRET=
SESSION_COOKIE_SECURE=false

# Comma-separated browser origins allowed by the FastAPI CORS policy.
FRONTEND_ORIGINS=http://localhost:3000

# Next.js browser-visible API origin; this is a URL, not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional JSON array replacing the default allowlist. Each item has name, domain, category, authority.
# LEGAL_SOURCES_JSON=[{"name":"Nepal Law Commission","domain":"lawcommission.gov.np","category":"Legislation","authority":"official"}]